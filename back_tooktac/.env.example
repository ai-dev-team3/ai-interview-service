# JWT
JWT_SECRET_KEY=

# CORS: 브라우저가 접속하는 프론트 origin 목록 (쉼표 구분, 필수)
# 로컬 예시: http://localhost:3000,http://127.0.0.1:3000
# 운영 예시: https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=

# access_token 쿠키 속성
# 로컬(HTTP): 아래 3개를 비워두면 domain 없음 / secure=false / samesite=lax 로 동작
# 운영(HTTPS): COOKIE_DOMAIN=.example.com, COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_DOMAIN=
COOKIE_SECURE=
COOKIE_SAMESITE=

# MySQL DB
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# VITO STT (리턴제로)
VITO_CLIENT_ID=
VITO_CLIENT_SECRET=

# Naver Clova Speech
CLOVA_SPEECH_API_URL=
CLOVA_API_KEY=
