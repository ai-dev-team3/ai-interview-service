# JWT
JWT_SECRET_KEY=

# CORS: 브라우저가 접속하는 프론트 origin 목록 (쉼표 구분, 필수)
# 로컬 예시: http://localhost:3000,http://127.0.0.1:3000
# 운영 예시: https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# access_token 쿠키 속성
# 로컬(HTTP): 아래 3개를 비워두면 domain 없음 / secure=false / samesite=lax 로 동작
# 운영(HTTPS): COOKIE_DOMAIN=.example.com, COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_DOMAIN=
COOKIE_SECURE=
COOKIE_SAMESITE=

# MySQL DB
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Langfuse (LLM 관측/대시보드)
# 값이 없으면 추적은 자동으로 꺼지고 앱은 그대로 동작한다.
# 키는 Langfuse 프로젝트 → Settings → API Keys 에서 발급.
# HOST 예시: Cloud(JP) https://jp.cloud.langfuse.com · EU https://cloud.langfuse.com · US https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://jp.cloud.langfuse.com

# VITO STT (리턴제로)
VITO_CLIENT_ID=
VITO_CLIENT_SECRET=

# Naver Clova Speech
CLOVA_SPEECH_API_URL=
CLOVA_API_KEY=
