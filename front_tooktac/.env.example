# 백엔드 API 주소. 비우면 same-origin '/api' 로 폴백한다 (Nginx 리버스 프록시 구성).
# 로컬 개발 예시: http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=

# WebSocket 주소 (필수). 값이 없으면 실행 시점에 에러가 발생한다.
# 로컬 개발 예시 — 로컬 백엔드 라우트에는 /api 접두사가 없음
#   NEXT_PUBLIC_STT_WS_URL=ws://localhost:8000/ws/transcript
#   NEXT_PUBLIC_EXPRESSION_WS_URL=ws://localhost:8000/ws/expression
# 운영 예시 (example.com은 실제 배포 도메인으로 교체)
#   NEXT_PUBLIC_STT_WS_URL=wss://example.com/api/ws/transcript
#   NEXT_PUBLIC_EXPRESSION_WS_URL=wss://example.com/api/ws/expression
NEXT_PUBLIC_STT_WS_URL=
NEXT_PUBLIC_EXPRESSION_WS_URL=
